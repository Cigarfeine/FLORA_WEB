# ============================================================================
# FLORA — Hybrid Room Visualizer Environment Configuration
# ============================================================================

# --- Frontend (Vite / GitHub Pages) ---
# Base URL of the deployed Vercel serverless API (leave empty when running on same origin)
# Example: https://flora-visualizer-api.vercel.app
VITE_API_BASE_URL=

# --- Backend (Vercel Serverless Function: api/visualize-room.ts) ---
# Required for AI Realistic Room Preview (Server-side only — NEVER prefix with VITE_)
OPENAI_API_KEY=

# Optional OpenAI GPT Image model override (defaults to gpt-image-2.5-sunburst)
# Supported: gpt-image-2.5-sunburst, gpt-image-2.5-flare, gpt-image-2, gpt-image-1.5, gpt-image-1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional OpenAI rendering quality (defaults to high)
# Supported: low, medium, high, auto
OPENAI_IMAGE_QUALITY=high

# Comma-separated list of permitted browser origins for CORS
ALLOWED_ORIGINS=https://cigarfeine.github.io,http://localhost:5173,http://localhost:4173

# Optional Upstash Redis REST credentials for distributed serverless rate limiting
# (Falls back to ephemeral in-memory rate limiting if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
